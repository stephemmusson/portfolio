<IfModule mod_rewrite.c>
RewriteEngine On
# Let certificate validation reach the origin without redirecting.
RewriteRule ^\.well-known/ - [L]
# The portfolio URL is an alias, not the indexed artist address.
RewriteCond %{HTTP_HOST} ^(?:www\.)?stephenmusson\.com$ [NC]
RewriteRule ^(.*)$ https://hensonsmith.com/$1 [R=301,L,NE]
# One public artist hostname: HTTPS without www.
RewriteCond %{HTTP_HOST} ^www\.hensonsmith\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?hensonsmith\.com$ [NC]
RewriteRule ^(.*)$ https://hensonsmith.com/$1 [R=301,L,NE]
</IfModule>

Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<FilesMatch "^(?:\.env|composer\.(?:json|lock)|.*\.(?:bak|sql|ini))$">
  Require all denied
</FilesMatch>

# Override the parent portfolio's immutable cache for the editable artist site.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|css|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:svg|webp|png|jpe?g|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
